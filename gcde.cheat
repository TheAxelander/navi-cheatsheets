% axl, gcde, sql

# Create SQL based on the named Enricher
./enricher_util.py --name <enricher> --show-global > <file>
$ file: echo '~/Downloads/test.sql'

# Display Table DDL of the named Persister
./persister_util.py --name <persister> --show-table-ddl > <file>
$ file: echo '~/Downloads/test.sql'
